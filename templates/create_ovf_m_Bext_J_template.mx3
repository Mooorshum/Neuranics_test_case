OutputFormat = OVF2_TEXT

Msat = 
Aex = 
alpha = 

size_x := 
size_y := 
size_z := 

Nx :=
Ny :=
Nz :=

cell_size_x := size_x / Nx
cell_size_y := size_y / Ny
cell_size_z := size_z / Nz

SetGridSize(Nx, Ny, Nz)
SetCellSize(cell_size_x, cell_size_y, cell_size_z)

m = RandomMag()

mask := newVectorMask(Nx, Ny, Nz)
for i:=0; i<Nx; i++{
    for j:=0; j<Ny; j++{
        for k:=0; k<Nz; k++{
            r := index2coord(i, j, 0)
            x := r.X()
            y := r.Y()
            z := r.Z()
            mask.setVector(i, j, k, vector(x, y, z))
        }
    }
}
B_ext.add(mask,1)
J.add(mask, 1)

saveas(m, "m")
saveas(B_ext, "B_ext")
saveas(J, "J")
